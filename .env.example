# The wallet-session route remains unavailable unless every required value is
# supplied through the deployment secret manager. Never commit real key bytes.
TREESWAP_WALLET_SESSION_ROUTE_MODE=closed-test
TREESWAP_WALLET_SESSION_API_ORIGIN=
TREESWAP_WALLET_SESSION_DEPLOYMENT_ID=
TREESWAP_WALLET_SESSION_CURRENT_REQUESTER_PUBLIC_KEY_PEM=
TREESWAP_WALLET_SESSION_CURRENT_RESPONSE_PRIVATE_KEY_PEM=

# Optional, bounded rotation overlap. Supply all three or none. The absolute
# expiry may be at most 900 seconds after the replacement deployment starts.
TREESWAP_WALLET_SESSION_RETIRING_REQUESTER_PUBLIC_KEY_PEM=
TREESWAP_WALLET_SESSION_RETIRING_RESPONSE_PRIVATE_KEY_PEM=
TREESWAP_WALLET_SESSION_RETIRING_ACCEPT_UNTIL_EPOCH_SECONDS=
